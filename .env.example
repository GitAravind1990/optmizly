# Optmizly environment variables
#
# Copy to .env.local and fill in. Grouped by what breaks without them, not by vendor:
# everything under REQUIRED must be set for the app to boot and sign a user in; the rest
# disables one feature at a time.
#
# Prisma reads .env, not .env.local, so DATABASE_URL and DIRECT_URL belong in both.


# ============================================================================
# REQUIRED
# ============================================================================

# --- Clerk auth --- dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_
CLERK_WEBHOOK_SECRET=whsec_

# These four are not optional in practice. Clerk defaults them to its own hosted pages,
# and a sign-in that lands somewhere this app does not serve is the loop that cost a day.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- Database (Supabase) ---
# Runtime: Transaction pooler, port 6543, and ?pgbouncer=true is required -- without it
# Prisma prepares statements the pooler cannot hold and the app dies under load.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations: Session pooler, port 5432. prisma migrate needs a direct connection.
DIRECT_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# --- LLM provider ---
# groq | anthropic | bedrock. Defaults to anthropic when unset; production runs groq.
# Whichever is set receives user content and is therefore a sub-processor: name it in
# /privacy section 5. Changing this variable IS a sub-processor change.
LLM_PROVIDER=groq

# Set the key matching LLM_PROVIDER. The code says "claude" throughout regardless --
# model ids are mapped per provider in src/lib/llm.ts, so never infer the live provider
# from a function or model name.
GROQ_API_KEY=gsk_
ANTHROPIC_API_KEY=sk-ant-api03-
# bedrock instead uses AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION.

NEXT_PUBLIC_APP_URL=http://localhost:3000


# ============================================================================
# PAYMENTS (DoDo Payments) -- checkout and plan changes without these
# ============================================================================

DODO_API_KEY=
DODO_WEBHOOK_SECRET=

# One product per plan and billing period. A plan whose id is missing or wrong silently
# grants FREE after a successful payment, so check all eight after creating them.
NEXT_PUBLIC_DODO_STARTER_PRODUCT_ID=
NEXT_PUBLIC_DODO_STARTER_ANNUAL_PRODUCT_ID=
NEXT_PUBLIC_DODO_PRO_PRODUCT_ID=
NEXT_PUBLIC_DODO_PRO_ANNUAL_PRODUCT_ID=
NEXT_PUBLIC_DODO_AGENCY_PRODUCT_ID=
NEXT_PUBLIC_DODO_AGENCY_ANNUAL_PRODUCT_ID=
NEXT_PUBLIC_DODO_AGENCY_PLUS_PRODUCT_ID=
NEXT_PUBLIC_DODO_AGENCY_PLUS_ANNUAL_PRODUCT_ID=

# Test mode needs DODO_MODE=test_mode *and* DODO_TEST_API_KEY -- both, so that a stray
# mode flag cannot point a live deployment at test, or the reverse.
# DODO_MODE=test_mode
# DODO_TEST_API_KEY=
# DODO_TEST_WEBHOOK_SECRET=


# ============================================================================
# SEO DATA VENDORS -- each throws in the tools that use it, not at boot
# ============================================================================

# DataForSEO: keyword research, SERP, rank tracking, local. Metered, and the reason
# TOOL_COST_UNITS charges 2-3 credits for the tools that call it.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Google: PageSpeed Insights (Core Web Vitals) and Places (Local SEO, Client Finder).
# Places resolves GOOGLE_PLACES_API_KEY first, then GOOGLE_API_KEY, then the public maps
# key -- so a restricted browser key can be overridden server-side without a code change.
GOOGLE_API_KEY=
GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=


# ============================================================================
# EMAIL, CRON, INTEGRATIONS
# ============================================================================

# Resend. Unset, every transactional send throws; the domain must also be verified or
# Resend refuses in the response body rather than by throwing.
RESEND_API_KEY=re_
EMAIL_FROM=Optmizly <hello@optmizly.com>

# Cron authentication. MUST be set. It is asserted, never interpolated: left unset,
# `Bearer ${process.env.CRON_SECRET}` is the literal string "Bearer undefined", which is
# a value anyone on the internet can send.
CRON_SECRET=

# Admin dashboard access and health alerts -- matched against the signed-in Clerk email.
ADMIN_EMAIL=

# Google OAuth for Search Console.
# Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Encrypts OAuth tokens at rest. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Upstash Redis: per-IP quotas on the public no-signup tools. Without it those tools run
# unmetered, which is fine locally and not in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# PostHog product analytics and error capture.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Microsoft Clarity session analytics. Unset means Clarity is not loaded at all, which is the
# right default -- it records and replays page interactions, so it should need a deliberate
# switch-on. It also only runs for visitors who accept the cookie banner. Adding it is a
# sub-processor change: /privacy section 5 names it.
NEXT_PUBLIC_CLARITY_ID=


# ============================================================================
# OPTIONAL -- sensible defaults, override only with a reason
# ============================================================================

# Groq model overrides. Default to openai/gpt-oss-20b and openai/gpt-oss-120b.
# GROQ_HAIKU_MODEL=
# GROQ_SONNET_MODEL=

# Tokens-per-minute the Groq limiter paces against. Default 8000 (the free tier).
# Groq charges prompt_tokens + max_tokens on acceptance and refunds nothing unused, so
# this is a spend control, not just a throttle.
# GROQ_TPM=8000

# AWS credentials and model ids, used only when LLM_PROVIDER=bedrock.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# BEDROCK_HAIKU_MODEL=
# BEDROCK_SONNET_MODEL=

# Overrides the dateModified printed on public pages. Defaults to the site's publish date.
# SITE_LAST_MODIFIED=

# Renders placeholder social proof. Leave unset -- there are no real testimonials yet, and
# inventing them is the credibility bug this flag exists to keep switched off.
# NEXT_PUBLIC_SHOW_PROOF_PLACEHOLDERS=
