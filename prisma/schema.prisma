generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Plan {
  FREE
  PRO
  AGENCY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
  PAUSED
  TRIALING
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  totalInputTokens  Int @default(0)
  totalOutputTokens Int @default(0)

  subscription            Subscription?
  usage                   Usage[]
  performanceAudits       PerformanceFixerAudit[]
  contentOptimizations    ContentOptimization[]
  clients                 Client[]                 @relation("AgencyClients")
  reportTemplates         ReportTemplate[]         @relation("ReportTemplates")
  contentIdeaProjects     ContentIdeaProject[]     @relation("ContentIdeaProjects")
  competitorAnalyses      CompetitorAnalysis[]     @relation("CompetitorAnalyses")
  competitorComparisons   CompetitorComparison[]   @relation("CompetitorComparisons")
  onPageAnalyses          OnPageAnalysis[]         @relation("OnPageAnalyses")
  rankTrackingProjects    RankTrackingProject[]    @relation("RankTrackingProjects")
  keywordListProjects     KeywordListProject[]     @relation("KeywordListProjects")
  localSEOAccounts        LocalSEOAccount[]        @relation("LocalSEOAccounts")
  llmVisibilityAnalyses   LLMVisibilityAnalysis[]  @relation("LLMVisibilityAnalyses")
  backlinkProjects        BacklinkProject[]        @relation("BacklinkProjects")
  backlinkAnalyses        BacklinkDomainAnalysis[] @relation("BacklinkDomainAnalyses")
  seoAudits               SeoAudit[]               @relation("SEOAudits")
  drippedEmails           DrippedEmail[]
  analysisHistory         AnalysisHistory[]
  searchConsoleConnection SearchConsoleConnection?
  gscQueryRows            GscQueryRow[]            @relation("GscQueryRows")
  dailyToolUsage          DailyToolUsage[]         @relation("DailyToolUsage")
  clientFinderSearches    ClientFinderSearch[]
  prospectContacts        ProspectContact[]
}

/// Per-day, per-tool usage, for tools capped daily rather than by the monthly Usage
/// quota. Kept separate from Usage deliberately: that table's rows drive the monthly
/// limit-warning and limit-reached emails, and mixing a different cadence into it would
/// corrupt those counts. `day` is a 'YYYY-MM-DD' string in UTC, matching how Usage
/// stores 'YYYY-MM' — a string key makes the unique constraint do the resetting, with no
/// job to run at midnight.
model DailyToolUsage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("DailyToolUsage", fields: [userId], references: [id], onDelete: Cascade)

  tool  String
  day   String
  count Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tool, day])
}

model Client {
  id       String @id @default(cuid())
  agencyId String
  agency   User   @relation("AgencyClients", fields: [agencyId], references: [id], onDelete: Cascade)

  name     String
  email    String
  website  String
  industry String?

  reportTemplate String  @default("standard")
  brandColor     String  @default("#6366f1")
  logoUrl        String?

  trackKeywords String @db.Text
  competitors   String @db.Text

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  reports   ClientReport[]

  @@index([agencyId])
}

model ClientReport {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  month Int
  year  Int

  keywordRankings String @db.Text
  trafficChange   Int?
  trafficCurrent  Int?
  backlinksAdded  Int?
  topPerformers   String @db.Text

  domainAuthority Float?
  pageAuthority   Float?
  backlinksTotal  Int?

  reportHtml   String  @db.Text
  reportPdfUrl String?

  emailSent      Boolean   @default(false)
  emailSentAt    DateTime?
  clientViewed   Boolean   @default(false)
  clientViewedAt DateTime?

  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
  @@index([month])
}

model ReportTemplate {
  id       String @id @default(cuid())
  agencyId String
  agency   User   @relation("ReportTemplates", fields: [agencyId], references: [id], onDelete: Cascade)

  name        String
  description String?
  sections    String  @db.Text
  customText  String? @db.Text
  footerText  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
}

model Subscription {
  id                      String             @id @default(cuid())
  userId                  String             @unique
  dodoSubscriptionId      String             @unique
  dodoCustomerId          String
  dodoProductId           String
  dodoPaymentId           String?
  status                  SubscriptionStatus @default(ACTIVE)
  plan                    Plan
  currentPeriodEnd        DateTime?
  cancelledAt             DateTime?
  welcomeEmailSent        Boolean            @default(false)
  trialConvertedEmailSent Boolean            @default(false)
  lastWebhookEventAt      DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Usage {
  id             String   @id @default(cuid())
  userId         String
  month          String // "2025-06" format
  count          Int      @default(0)
  limitEmailSent Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
}

model PerformanceFixerAudit {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  url        String
  industry   String?
  analyzedAt DateTime @default(now())

  lcp Float
  fid Float?
  inp Float?
  cls Float

  lcpScore       Int
  fidScore       Int?
  clsScore       Int
  overallScore   Int
  projectedScore Int

  revenueLoss      Float?
  potentialRevenue Float?
  fixTime          Int
  fixCost          Float

  fixes           String
  totalFixes      Int
  extendedMetrics String? @db.Text

  industryAvg  Int?
  industryRank Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aiFixes AIFixGeneration[]

  @@index([userId])
}

model AIFixGeneration {
  id      String                @id @default(cuid())
  auditId String
  audit   PerformanceFixerAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  fixType         String
  language        String
  beforeCode      String
  afterCode       String
  description     String
  estimatedImpact Int
  applied         Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([auditId])
}

model ContentOptimization {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  content       String  @db.Text
  targetKeyword String
  contentUrl    String?

  detectedIntent    String
  intentMatchScore  Int
  intentSuggestions String @db.Text

  entities            String @db.Text
  entityScore         Int
  missingEntities     String @db.Text
  entityRelationships String @db.Text

  lsiKeywords String @db.Text
  missingLsi  String @db.Text
  lsiScore    Int

  recommendedSchema String
  schemaJsonLd      String @db.Text

  mainTopic          String
  subtopicsCovered   String @db.Text
  subtopicsMissing   String @db.Text
  topicCoverageScore Int

  pillarSuggestion   String?
  clusterSuggestions String? @db.Text
  internalLinkingOps String? @db.Text

  experienceScore Int
  expertiseScore  Int
  authorityScore  Int
  trustScore      Int
  eeatOverall     Int

  overallScore       Int
  rewriteSuggestions String @db.Text
  improvements       String @db.Text

  analyzedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  fixes ContentOptimizationFix[]

  @@index([userId])
}

model BlogPost {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  description   String
  content       String    @db.Text
  contentType   String    @default("markdown") // "html" | "markdown"
  category      String
  tags          String    @default("") // comma-separated
  featuredImage String?
  readingTime   String    @default("5 min read")
  author        String    @default("Aravindraj")
  authorTitle   String    @default("Founder, Optmizly")
  published     Boolean   @default(false)
  publishedAt   DateTime?
  scheduledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([published, publishedAt])
}

model BlogSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String?
  createdAt DateTime @default(now())
}

model ContentOptimizationFix {
  id             String              @id @default(cuid())
  optimizationId String
  optimization   ContentOptimization @relation(fields: [optimizationId], references: [id], onDelete: Cascade)

  category   String
  priority   String
  issue      String
  suggestion String  @db.Text
  beforeText String? @db.Text
  afterText  String? @db.Text
  applied    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([optimizationId])
}

model ContentIdeaProject {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("ContentIdeaProjects", fields: [userId], references: [id], onDelete: Cascade)

  name           String
  industry       String
  targetAudience String
  seedKeywords   String @db.Text
  competitors    String @db.Text

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  ideas     ContentIdea[]
  calendar  ContentCalendar[]

  @@index([userId])
}

model ContentIdea {
  id        String             @id @default(cuid())
  projectId String
  project   ContentIdeaProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  slug        String
  description String?

  primaryKeyword  String
  relatedKeywords String  @db.Text
  searchVolume    Int
  difficulty      Int
  cpc             Float?
  // True when searchVolume/difficulty/cpc came from a real DataForSEO lookup for
  // primaryKeyword rather than Claude's own invented "realistic" number.
  metricsReal     Boolean @default(false)

  contentType     String
  estimatedLength Int
  sections        String @db.Text

  entitiesNeeded String @db.Text
  lsiKeywords    String @db.Text
  semanticGaps   String @db.Text

  eeatScore        Int
  competitorCount  Int
  opportunityScore Int

  status     String    @default("idea")
  assignedTo String?
  dueDate    DateTime?

  aiOutline String? @db.Text
  aiIntro   String? @db.Text

  pinned Boolean @default(false)
  notes  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([difficulty])
  @@index([opportunityScore])
}

model CompetitorAnalysis {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("CompetitorAnalyses", fields: [userId], references: [id], onDelete: Cascade)

  domainUrl  String
  domainName String
  userDomain String?

  estimatedTraffic Int
  domainAuthority  Float
  pageAuthority    Float
  backlinksTotal   Int
  backlinksNew     Int

  topKeywords   String @db.Text
  keywordCount  Int
  brandKeywords String @db.Text

  topPages         String @db.Text
  contentCount     Int
  avgContentLength Int

  topBacklinks    String @db.Text
  backlinksSource String @db.Text

  gapKeywords     String @db.Text
  missingEntities String @db.Text
  contentOpps     String @db.Text

  aiInsights String? @db.Text

  dataQuality    String   @default("high")
  lastAnalyzedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([domainUrl])
}

model CompetitorComparison {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("CompetitorComparisons", fields: [userId], references: [id], onDelete: Cascade)

  name        String
  yourDomain  String
  competitors String @db.Text

  comparisonData String @db.Text
  keywordOverlap String @db.Text
  uniqueToYou    String @db.Text
  uniqueToThem   String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model OnPageAnalysis {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("OnPageAnalyses", fields: [userId], references: [id], onDelete: Cascade)

  content       String  @db.Text
  targetKeyword String
  pageUrl       String?
  pageTitle     String?

  overallScore Int

  keywordScore     Int
  headerScore      Int
  metaScore        Int
  imageScore       Int
  linkScore        Int
  readabilityScore Int

  keywordDensity Float
  keywordCount   Int
  wordCount      Int
  keywordData    String @db.Text

  headers         String @db.Text
  metaTags        String @db.Text
  images          String @db.Text
  links           String @db.Text
  readabilityData String @db.Text

  fixes        String @db.Text
  appliedFixes String @db.Text

  version       Int  @default(1)
  previousScore Int?

  analyzedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([targetKeyword])
}

model ContentCalendar {
  id        String             @id @default(cuid())
  projectId String
  project   ContentIdeaProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ideaId    String?

  title       String
  publishDate DateTime
  status      String   @default("planned")
  notes       String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([publishDate])
}

model KeywordListProject {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("KeywordListProjects", fields: [userId], references: [id], onDelete: Cascade)

  name           String
  targetLocation String @default("US")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  keywords KeywordResearchResult[]

  @@index([userId])
}

model KeywordResearchResult {
  id        String             @id @default(cuid())
  projectId String
  project   KeywordListProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  keyword      String
  isSeed       Boolean @default(false)
  searchVolume Int?
  difficulty   Int?
  cpc          Float?
  trend        String?
  intent       String?
  /// Comma-separated top-3 ranking domains, filled on demand for Magic Keyword
  /// candidates so KD's page-level blind spot can be eyeballed. Null = not checked.
  topDomains   String?

  createdAt DateTime @default(now())

  @@unique([projectId, keyword])
  @@index([projectId])
}

model RankTrackingProject {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("RankTrackingProjects", fields: [userId], references: [id], onDelete: Cascade)

  name           String
  domain         String
  targetLocation String @default("US")
  deviceType     String @default("desktop")

  trackKeywords   String    @db.Text
  updateFrequency String    @default("daily")
  lastUpdatedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  keywords RankTrackingKeyword[]
  history  RankHistory[]
  alerts   RankAlert[]

  @@index([userId])
  @@index([domain])
}

model RankTrackingKeyword {
  id        String              @id @default(cuid())
  projectId String
  project   RankTrackingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  keyword      String
  searchVolume Int?
  difficulty   Int?

  currentRank Int?
  currentUrl  String?

  rankChange30d    Int?
  rankChange7d     Int?
  rankTrendPercent Float?

  status       String    @default("tracking")
  achievedRank Int?
  notes        String?   @db.Text
  lastRanked   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history RankHistory[]

  @@unique([projectId, keyword])
  @@index([projectId])
  @@index([currentRank])
}

model RankHistory {
  id        String              @id @default(cuid())
  projectId String
  project   RankTrackingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  keywordId String
  keyword   RankTrackingKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  rank         Int?
  url          String?
  searchVolume Int?
  checkedDate  DateTime @default(now())

  @@unique([keywordId, checkedDate])
  @@index([projectId])
  @@index([keywordId])
  @@index([checkedDate])
}

model RankAlert {
  id        String              @id @default(cuid())
  projectId String
  project   RankTrackingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  keyword   String
  alertType String // "position_drop", "position_gain", "first_page", "top_3", "lost_ranking"
  threshold Int?
  oldRank   Int?
  newRank   Int?
  message   String  @db.Text
  read      Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([read])
}

model LocalSEOAccount {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("LocalSEOAccounts", fields: [userId], references: [id], onDelete: Cascade)

  name         String
  accountType  String  @default("multi-location")
  gbpConnected Boolean @default(false)
  gbpEmail     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations LocalSEOLocation[]
  reviews   LocalReview[]
  citations LocalCitation[]
  tasks     LocalSEOTask[]

  @@index([userId])
}

model LocalSEOLocation {
  id        String          @id @default(cuid())
  accountId String
  account   LocalSEOAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name    String
  address String
  city    String
  state   String
  zipCode String
  phone   String
  website String?

  gbpId    String?
  gmapsUrl String?

  averageRating Float?
  reviewCount   Int?

  localKeywords String @db.Text

  pageViews  Int?
  calls      Int?
  directions Int?

  citationScore Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  keywords  LocalKeywordRank[]
  reviews   LocalReview[]
  citations LocalCitation[]

  @@unique([accountId, gbpId])
  @@index([accountId])
  @@index([city])
}

model LocalKeywordRank {
  id         String           @id @default(cuid())
  locationId String
  location   LocalSEOLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  keyword    String
  searchType String @default("local")

  currentRank  Int?
  previousRank Int?

  rankChange7d  Int?
  rankChange30d Int?

  searchVolume Int?
  difficulty   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history LocalRankHistory[]

  @@unique([locationId, keyword, searchType])
  @@index([locationId])
  @@index([currentRank])
}

model LocalRankHistory {
  id        String           @id @default(cuid())
  keywordId String
  keyword   LocalKeywordRank @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  rank        Int?
  checkedDate DateTime @default(now())

  @@unique([keywordId, checkedDate])
  @@index([keywordId])
  @@index([checkedDate])
}

model LocalReview {
  id        String          @id @default(cuid())
  accountId String
  account   LocalSEOAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  locationId String
  location   LocalSEOLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  source     String
  reviewText String  @db.Text
  rating     Int
  author     String?

  responded    Boolean @default(false)
  responseText String? @db.Text

  flaggedAsNegative Boolean   @default(false)
  createdAt         DateTime  @default(now())
  reviewedDate      DateTime?

  @@index([accountId])
  @@index([locationId])
  @@index([rating])
}

model LocalCitation {
  id        String          @id @default(cuid())
  accountId String
  account   LocalSEOAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  locationId String
  location   LocalSEOLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  source          String
  sourceUrl       String
  businessName    String
  businessPhone   String
  businessAddress String

  nameMatches    Boolean @default(true)
  phoneMatches   Boolean @default(true)
  addressMatches Boolean @default(true)

  status           String  @default("verified")
  issueDescription String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, locationId, source])
  @@index([accountId])
  @@index([locationId])
}

model LLMVisibilityAnalysis {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("LLMVisibilityAnalyses", fields: [userId], references: [id], onDelete: Cascade)

  websiteUrl String
  domain     String

  llmVisibilityScore  Int
  semanticRelevance   Int
  retrievalLikelihood Int
  contentStructure    Int
  answerability       Int
  technicalAccess     Int

  pagesAnalyzed Int
  totalWords    Int

  topicsFound   Int
  entitiesFound Int
  faqSections   Int

  criticalGaps    String @db.Text
  warnings        String @db.Text
  opportunities   String @db.Text
  recommendations String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages      LLMVisibilityPage[]
  queryTests LLMQueryTest[]

  @@index([userId])
  @@index([llmVisibilityScore])
}

model LLMVisibilityPage {
  id         String                @id @default(cuid())
  analysisId String
  analysis   LLMVisibilityAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  url   String
  title String

  pageScore      Int
  semanticScore  Int
  structureScore Int
  answerScore    Int

  wordCount    Int
  headingCount Int
  listCount    Int
  faqCount     Int

  mainTopic String?
  subtopics String  @db.Text
  entities  String  @db.Text

  retrievable     Boolean
  retrievalReason String?

  issues String @db.Text

  createdAt DateTime @default(now())

  @@index([analysisId])
  @@index([pageScore])
}

model LLMQueryTest {
  id         String                @id @default(cuid())
  analysisId String
  analysis   LLMVisibilityAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  query     String
  queryType String

  retrieved      Boolean
  retrievalScore Float

  topRetrievedPage  String?
  topRetrievedChunk String? @db.Text

  answer        String? @db.Text
  answerQuality Int?

  missingContent String @db.Text

  createdAt DateTime @default(now())

  @@index([analysisId])
  @@index([retrievalScore])
}

model BacklinkDomainAnalysis {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("BacklinkDomainAnalyses", fields: [userId], references: [id], onDelete: Cascade)

  domain String

  // Overview metrics
  // backlinksTotal/dofollowLinks/nofollowLinks are BigInt, not Int — a real domain's
  // raw backlink count (as opposed to unique referring domains) can exceed Postgres
  // INT4's ~2.1B ceiling; github.com alone was observed at 3.43B, which threw an
  // unhandled Prisma overflow error on every real analysis of a sufficiently large site.
  backlinksTotal          BigInt @default(0)
  dofollowLinks           BigInt @default(0)
  nofollowLinks           BigInt @default(0)
  referringDomains        Int    @default(0)
  referringIPs            Int    @default(0)
  spamScore               Int    @default(0)
  brokenBacklinks         Int    @default(0)
  newBacklinks14d         Int    @default(0)
  lostBacklinks14d        Int    @default(0)
  newReferringDomains14d  Int    @default(0)
  lostReferringDomains14d Int    @default(0)
  domainRank              Int    @default(0)
  oprScore                Float  @default(0)

  // Cached JSON arrays
  topBacklinks        String @db.Text
  topReferringDomains String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([domain])
}

model BacklinkProject {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("BacklinkProjects", fields: [userId], references: [id], onDelete: Cascade)

  name           String
  domain         String
  niche          String
  targetKeywords String @db.Text
  contentBrief   String @db.Text

  totalOpportunities Int @default(0)
  contactedCount     Int @default(0)
  securedCount       Int @default(0)

  aiSummary String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunities BacklinkOpportunity[]

  @@index([userId])
}

model BacklinkOpportunity {
  id        String          @id @default(cuid())
  projectId String
  project   BacklinkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  siteName        String
  siteUrl         String
  domainAuthority String
  linkType        String
  angle           String @db.Text
  whyRelevant     String @db.Text
  contactApproach String @db.Text
  difficulty      String
  impact          String

  status String  @default("prospecting")
  notes  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
}

model SeoAudit {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("SEOAudits", fields: [userId], references: [id], onDelete: Cascade)

  url       String
  pageTitle String?

  overallScore Int
  totalChecks  Int
  passedChecks Int
  failedChecks Int
  warnChecks   Int

  categoryScores String  @db.Text // JSON: { [categoryKey]: number }
  autoResults    String  @db.Text // JSON: { [checkId]: { status, detail } }
  aiResults      String  @db.Text // JSON: { [categoryKey]: { score, issues, fixes } }
  checklistState String  @db.Text // JSON: { [checkId]: 'pass'|'fail'|'na' }
  backlinkData   String? @db.Text // JSON: { oprScore, domainRank }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Stored Search Console Search Analytics rows — Google's own measured impressions,
/// clicks and average position for queries a connected property actually ranks for.
///
/// This is ground truth, and the only ground truth available without a clickstream
/// panel: every other number in the product is a vendor estimate. It exists so volume
/// and difficulty estimates can eventually be scored against real data rather than
/// trusted. Deliberately append-and-refresh rather than transient, because the
/// calibration value comes from accumulated history that cannot be backfilled later
/// than Google's ~16-month retention window.
model GscQueryRow {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("GscQueryRows", fields: [userId], references: [id], onDelete: Cascade)

  /// The GSC property this came from, verbatim ("sc-domain:x.com" or "https://x.com/").
  siteUrl String
  date    DateTime @db.Date
  query   String   @db.Text
  /// Null unless the sync was run with the high-cardinality "page" dimension.
  page    String?  @db.Text
  country String
  device  String

  clicks      Int
  impressions Int
  ctr         Float
  position    Float

  fetchedAt DateTime @default(now())

  /// SHA-256 of the dimension tuple. Postgres btree tuples cap around 2.7KB and a
  /// query+page pair can exceed that, so the uniqueness constraint hashes the
  /// dimensions instead of indexing the raw strings.
  dimHash String

  @@unique([userId, dimHash])
  @@index([userId, siteUrl])
  @@index([userId, date])
}

model SearchConsoleConnection {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessTokenEnc  String   @db.Text // encrypted, see src/lib/crypto.ts
  refreshTokenEnc String   @db.Text // encrypted, see src/lib/crypto.ts
  scope           String
  tokenExpiresAt  DateTime

  sitesCache     String?   @db.Text // JSON string[] from the last sites.list call
  sitesFetchedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AnalysisHistory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contentSnippet String
  contentUrl     String?
  overallScore   Int
  grade          String
  result         String  @db.Text

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model DrippedEmail {
  id        String   @id @default(cuid())
  userId    String
  emailType String // 'drip_day1' | 'drip_day3' | 'drip_day7'
  sentAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, emailType])
  @@index([userId])
}

model LocalSEOTask {
  id        String          @id @default(cuid())
  accountId String
  account   LocalSEOAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  locationId  String?
  title       String
  description String? @db.Text
  category    String
  priority    String
  status      String  @default("open")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([status])
}

/// One row per execution of any scheduled job in vercel.json.
///
/// Every cron here runs unattended and reports only by side effect — an email that
/// arrives, a corpus that grows. A run that succeeded produced no record, and neither did
/// a job that had silently stopped firing weeks earlier, so the two were indistinguishable
/// from outside. Alerts are failure-only and this plan retains no runtime logs, which left
/// nothing to inspect after the fact either.
///
/// This is the durable trace. The absence of a recent row is itself the alarm.
model CronRun {
  id String @id @default(cuid())

  /// Matches CronJob in src/lib/cron.ts: health | drip | weekly | trial-reminder | gsc-sync.
  job    String
  ranAt  DateTime @default(now())
  ok     Boolean
  /// Wall-clock duration of the whole run, milliseconds.
  ms     Int
  /// Whatever the job counted, kept whole so a past run can be read back with its original
  /// numbers rather than a summary. For health this is the full Check[]
  /// ({ name, ok, detail, ms }[]); for the mailers, the sent/skipped/error tallies.
  detail Json

  @@index([job, ranAt])
  @@index([ranAt])
}

/// One saved SEO Client Finder search, so an agency can revisit prospects without
/// re-running (and re-paying for) the discovery.
///
/// The prospects are stored as a JSON blob rather than normalised into prospect and
/// finding tables. That is deliberate for this stage: nothing queries across prospects,
/// the results are a snapshot of a moment rather than living records, and a schema for
/// prospects would commit to a shape the tool is still changing. Roughly 20-30KB per
/// search. Normalise when something actually needs to ask a question across them.
model ClientFinderSearch {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  industry String
  location String
  service  String?

  /// The full prospects array exactly as the API returned it, findings included.
  prospects String @db.Text

  /// Outreach drafts keyed by prospect id: { "<placeId>": { subject, body } }.
  /// A column on the search rather than a table of its own - a draft has no meaning apart
  /// from the prospect it was written for, and that prospect only exists inside the blob
  /// above. Defaults to "{}" so rows written before this column existed read as "no drafts"
  /// rather than null-checking at every use.
  drafts String @default("{}") @db.Text

  found    Int
  analyzed Int

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Where a prospect stands with this agency, tracked across searches.
///
/// Keyed by Google's placeId rather than by a search, because that is the whole point: run
/// two searches over the same city and the overlapping businesses must remember they were
/// already contacted. A status stored inside a search blob could not do that.
///
/// businessName is denormalised so the list is readable without loading a search that may
/// since have been pruned by the 50-search retention.
model ProspectContact {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Google Places id - stable per business, and what search results are matched on.
  placeId      String
  businessName String

  /// CONTACTED | REPLIED | WON | DEAD. "Not contacted" is the absence of a row rather than
  /// a stored value, so the table holds only prospects actually worked.
  status String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, placeId])
  @@index([userId, updatedAt])
}
